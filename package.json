{
  "name": "@moku-labs/system",
  "version": "0.1.0",
  "description": "Isomorphic system API for Moku \u2014 store, notify, clipboard, tray, and deep-link capabilities via an env-style provider pattern (Tauri provider when the shell is detected, web fallback otherwise). Same island code runs on web and native.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./store": {
      "import": {
        "types": "./dist/store.d.mts",
        "default": "./dist/store.mjs"
      },
      "require": {
        "types": "./dist/store.d.cts",
        "default": "./dist/store.cjs"
      }
    },
    "./tray": {
      "import": {
        "types": "./dist/tray.d.mts",
        "default": "./dist/tray.mjs"
      },
      "require": {
        "types": "./dist/tray.d.cts",
        "default": "./dist/tray.cjs"
      }
    },
    "./notify": {
      "import": {
        "types": "./dist/notify.d.mts",
        "default": "./dist/notify.mjs"
      },
      "require": {
        "types": "./dist/notify.d.cts",
        "default": "./dist/notify.cjs"
      }
    },
    "./clipboard": {
      "import": {
        "types": "./dist/clipboard.d.mts",
        "default": "./dist/clipboard.mjs"
      },
      "require": {
        "types": "./dist/clipboard.d.cts",
        "default": "./dist/clipboard.cjs"
      }
    },
    "./deep-link": {
      "import": {
        "types": "./dist/deep-link.d.mts",
        "default": "./dist/deep-link.mjs"
      },
      "require": {
        "types": "./dist/deep-link.d.cts",
        "default": "./dist/deep-link.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moku-labs/system.git"
  },
  "homepage": "https://github.com/moku-labs/system#readme",
  "bugs": {
    "url": "https://github.com/moku-labs/system/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "tsdown",
    "validate": "publint && attw --pack . --profile node16",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@arethetypeswrong/core": "0.18.3",
    "@biomejs/biome": "2.4.16",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-store": "2.4.3",
    "@types/bun": "1.3.14",
    "@vitest/coverage-istanbul": "4.0.18",
    "eslint": "9.39.3",
    "eslint-config-biome": "2.1.3",
    "eslint-plugin-jsdoc": "62.6.0",
    "eslint-plugin-sonarjs": "4.0.0",
    "eslint-plugin-unicorn": "63.0.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "lefthook": "2.1.1",
    "publint": "0.3.21",
    "tsdown": "0.22.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.0",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@moku-labs/common": "0.3.0",
    "@moku-labs/core": "1.5.0",
    "idb-keyval": "6.3.0"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-deep-link": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-store": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": {
      "optional": true
    },
    "@tauri-apps/plugin-clipboard-manager": {
      "optional": true
    },
    "@tauri-apps/plugin-deep-link": {
      "optional": true
    },
    "@tauri-apps/plugin-notification": {
      "optional": true
    },
    "@tauri-apps/plugin-store": {
      "optional": true
    }
  },
  "sideEffects": false
}
